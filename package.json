{
  "name": "jv-autoescuela-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web y turnero online para JV Autoescuela (Hurlingham) preparado para Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
